# Horus environment template.
# Copy to .env and adjust values if you need to override the defaults.
# All variables are optional; the application works with the built-in defaults.

# --- Backend (FastAPI) ---

# Directory containing the serialized models (*.pkl).
# MODELS_DIR=backend/app/api/models

# Path to the model metrics table (CSV).
# METRICS_PATH=backend/app/api/models/models_results.csv

# Comma-separated list of allowed CORS origins.
# CORS_ORIGINS=*

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# LOG_LEVEL=INFO

# Per-model prediction timeout in seconds.
# MODEL_TIMEOUT_SECONDS=10.0

# --- Frontend (Streamlit) ---

# Base URL of the FastAPI backend.
# API_URL=http://localhost:8000/
